{
  "framework": null,
  "functions": {
    "api/server.js": {
      "memory": 1024,
      "maxDuration": 15,
      "includeFiles": "assets/fonts/**"
    }
  },
  "rewrites": [
    {
      "source": "/public/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/server"
    }
  ]
}
