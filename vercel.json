{
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Vercel-Json-Active", "value": "yes" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/public/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/",
      "destination": "/api/home"
    },
    {
      "source": "/(.+)",
      "destination": "/api/index.js"
    }
  ]
}
